# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# `npm run db:local` (embedded Postgres) and `docker compose up -d` both serve
# exactly this URL, so it works unchanged with either.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/evms

# Secret used to sign JWTs. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# How long a login session (JWT + cookie) lasts.
SESSION_TTL_HOURS=8
# Send the session cookie only over HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# Comma-separated origins allowed to call the API with credentials.
# In development the Vite dev server proxies /api, so this is rarely needed.
CLIENT_ORIGIN=http://localhost:5173

# Where uploaded signature images are stored (relative to /server).
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=2

# Used for "Approved today" / "Rejected today" and for "date cannot be in the future" checks.
APP_TIMEZONE=Asia/Kolkata

# --- Local embedded Postgres (npm run db:local) ------------------------------
LOCAL_PG_PORT=5433
